# Optional configuration. Development: copy to .env. Global launch: copy to the printed user-data/config.env.
BC_UI_PORT=3000
BC_LAN_PORT=4455
# auto selects a private IPv4 LAN interface, falling back to loopback.
# Use 127.0.0.1 for same-computer testing, or a particular LAN IPv4 address.
BC_LAN_HOST=auto
BC_DISCOVERY=true
# BC_DATA_DIR=/absolute/path/to/private-data
# BC_CONFIG_FILE=/absolute/path/to/config.env

# Optional internet delivery. Both friends configure exactly the same URL.
# Blank keeps LAN-only operation. No built-in hosted relay is supplied.
# BC_RELAY_URL=wss://relay.your-domain.example/relay
# For npm run dev only: BC_RELAY_URL=ws://127.0.0.1:8787/relay
