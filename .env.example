# Optional configuration. Development: copy to .env. Global launch: copy to the printed user-data/config.env.
BC_UI_PORT=3000
BC_LAN_PORT=4455
# auto selects a private IPv4 LAN interface, falling back to loopback.
# Use 127.0.0.1 for same-computer testing, or a particular LAN IPv4 address.
BC_LAN_HOST=auto
BC_DISCOVERY=true
# BC_DATA_DIR=/absolute/path/to/private-data
# BC_CONFIG_FILE=/absolute/path/to/config.env

# Optional internet delivery override. The Butter Chicken Cloudflare relay is preconfigured by default:
# wss://butterchickenworker.bakri-downtime-sub.workers.dev/relay
# No config file edit is needed for internet chat between any two installed copies.
# To use a different relay, uncomment one of the below:
# BC_CLOUDFLARE_RELAY=butterchickenworker.bakri-downtime-sub.workers.dev
# BC_RELAY_URL=wss://butterchickenworker.bakri-downtime-sub.workers.dev/relay
# For npm run dev only: BC_RELAY_URL=ws://127.0.0.1:8787/relay
